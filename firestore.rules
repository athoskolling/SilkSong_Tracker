rules_version = '2';

// Silksong Guide: Firestore rules for the site's own Firebase project (ADR 0004).
// Written from scratch. One document per user, silksong_progress/{uid}, holds that
// user's Progress (docs/CONTRACTS.md sections 1 and 3). Everything else is denied.
// Tested in the Emulator by tests/firestore-rules.test.js. Athos publishes this file.

service cloud.firestore {
  match /databases/{database}/documents {

    // The signed-in user is the owner of the document whose id is their own uid.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // The shape js/firebase.js writeProgressDoc sends: four required keys, plus two
    // optional ones (ADR 0006).
    // - Required: done, visited, updatedAt, dataVersion. progress.js always sends all
    //   four (it builds every write from a normalized local Progress), and an older
    //   page sends only these four, so a four-key document must stay accepted.
    // - Optional: crestSlots and builds (maps). When present they must be maps. A
    //   field that is absent is fine: "missing" means a page that does not know the
    //   field, not "empty" (ADR 0006).
    // - syncedUid and any other key are refused: syncedUid belongs to one device and
    //   must never reach the cloud (contract section 3).
    // - There is no size cap on the maps and nested values are not checked, as done
    //   and visited are not: the 1 MiB document limit already bounds them, and any
    //   number would be a guess at the game's entry count.
    // - shellShards is refused on purpose: that field was dropped from Progress
    //   (ADR 0007; Shell Shards are worked out from entries, like the Rosaries),
    //   so a document carrying it is refused like any other unknown key.
    function isProgressShape(data) {
      return data.keys().hasOnly(['done', 'visited', 'updatedAt', 'dataVersion', 'crestSlots', 'builds'])
        && data.keys().hasAll(['done', 'visited', 'updatedAt', 'dataVersion'])
        && data.done is map
        && data.visited is map
        && data.updatedAt is number
        && data.dataVersion is int
        && (!('crestSlots' in data) || data.crestSlots is map)
        && (!('builds' in data) || data.builds is map);
    }

    match /silksong_progress/{uid} {
      // "get" (one document) and not "read": "read" would also allow "list", and
      // the code never lists the collection. onSnapshot on a document needs only "get".
      allow get: if isOwner(uid);

      // Create and update both check the shape of the document as it WILL be.
      allow create, update: if isOwner(uid) && isProgressShape(request.resource.data);

      // "Start a new run" deletes the cloud copy.
      allow delete: if isOwner(uid);
    }

    // Everything else, for anyone, signed in or not, has no rule and is therefore denied.
    // (Firestore denies by default; this explicit rule is a second lock, kept on purpose.)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
